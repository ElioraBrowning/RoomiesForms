# ==============================================================================
# RoomiesForms - Localhost Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Web/.env)
# ------------------------------------------------------------------------------
# Backend API base URL accessed by the React frontend
VITE_API_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID for Southeastern Louisiana University sign-in
VITE_GOOGLE_CLIENT_ID=455201206803-2dhapidfn5ilbp4s962n63q2bkel5915.apps.googleusercontent.com

# Google Apps Script Webhook URL for Google Sheets synchronization
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycby0thrZGC-ojhzTBD1thdciA5y30HnQ9N4E0GsQ7mgKJ2RdtiT_l-SBFeCz9iUL5woHkQ/exec
VITE_GOOGLE_APPS_SCRIPT_KEY=

# ------------------------------------------------------------------------------
# Backend (Backend/.env or appsettings.Development.json)
# ------------------------------------------------------------------------------
# ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# SQLite Database Connection String
ConnectionStrings__DefaultConnection=Data Source=localdev.db

# JWT Token Secret Key
Jwt__Key=super_secret_key_for_development_purposes_only_12345!

# Google OAuth Credentials (for exchanging auth code with Google API)
Google__ClientId=455201206803-2dhapidfn5ilbp4s962n63q2bkel5915.apps.googleusercontent.com
Google__ClientSecret=
